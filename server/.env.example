PORT=3000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Preferred: keep the service account file at server/service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Alternative to GOOGLE_APPLICATION_CREDENTIALS: provide the complete one-line JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Exact origin(s) allowed to call this API; comma-separated for preview/local URLs.
CLIENT_ORIGIN=http://localhost:4200

WHATSAPP_TOKEN=your-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
GRAPH_API_VERSION=v25.0
META_VERIFY_TOKEN=replace-with-a-long-random-value
META_APP_SECRET=your-meta-app-secret
MESSAGE_DELAY_MS=250
